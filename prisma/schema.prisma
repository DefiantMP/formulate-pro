generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ingredient template — matches the IngredientLine[] shape in lib/calc-engine/types.ts
model Formulation {
  id        String   @id @default(cuid())
  name      String   @unique
  ingredients Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs         Run[]
  batchHistory BatchHistory[]
}

// A saved calculation: the inputs that produced it, the computed output, and
// which formulation template was in effect.
model Run {
  id            String   @id @default(cuid())
  label         String
  // Which product this batch is of ("OGS", "RR77"), as distinct from label,
  // which is a free-text name for this one run and in practice carries dates
  // and rework notes ("77s rework - 7/20/26"). Kept as its own column rather
  // than parsed back out of label, because grouping runs by product is what
  // makes prior-run suggestions possible and label is too irregular to key on.
  // Nullable and additive: every run predating this column has none, and a
  // run without a product simply gets no suggestions.
  product       String?
  mode          String // 'fresh' | 'regrind'
  formulationId String
  formulation   Formulation @relation(fields: [formulationId], references: [id])
  inputs        Json
  result        Json
  // Audit trail for a Tier 2 AI-verification discrepancy the operator
  // reviewed and acknowledged before saving: { acknowledgedAt, field,
  // reportedValue, computedValue, delta, unit }. Null when the run had no
  // discrepancy needing review.
  verificationAcknowledgment Json?
  createdAt     DateTime @default(now())

  // COA (Certificate of Analysis) results, entered on the Run History page
  // after the batch is physically made and lab-tested. All nullable/additive
  // — absent on every run until an operator records them.
  // Batch-level QC sign-off — the Part 111 batch production record review.
  // Distinct from ScaleVerification.status, which approves ONE weighing — this
  // is a reviewer accepting the batch as a whole. Null means never reviewed,
  // which for a run predating GMP mode is "grandfathered", not "pending" —
  // that distinction is drawn from the toggle log, not from this column.
  reviewStatus  String?   // 'pending' | 'approved' | 'rejected'
  // Free-text name captured before accounts existed. @map keeps the original
  // column, so renaming the field costs no data movement — the old values stay
  // exactly where they were and stay readable. Never auto-matched to a User by
  // name similarity: guessing which account an old string meant would put a
  // signature on a batch record that nobody actually gave.
  legacyReviewerName String? @map("reviewerName")
  reviewerId    String?
  reviewer      User?     @relation("RunReviewer", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  reviewNotes   String?   // required when reviewStatus is 'rejected'
  actualMgPerTablet  Float?
  actualTabletWeight Float?
  passFail           String? // 'pass' | 'fail'
  notes              String?

  // Soft delete — same retiredAt-style pattern as SpecCriterion below.
  // A hard delete is unsafe here: ScaleVerification.runId is a required,
  // non-cascading FK (see below), so deleting a run with any scale
  // verification against it would fail the constraint or, worse, orphan
  // that verification's audit trail. Null on every run until archived;
  // GET /api/runs (and /api/products, which reads run.product for
  // suggestions) filter this out by default.
  deletedAt DateTime?

  scaleVerifications ScaleVerification[]
  deviations         RunDeviation[]
  // Back-relation for RunLotUsage's FK (see below). Virtual field only —
  // Prisma requires it to declare the relation, but the column and FK both
  // live on RunLotUsage, so this adds no column to Run and no table rebuild.
  lotUsages          RunLotUsage[]
  labNotes      LabNote[]
  // Who saved the batch. Nullable: runs from before accounts, and runs saved
  // signed out with GMP mode off, have none. With GMP mode on a run cannot be
  // saved signed out, and its reviewer must be a different account.
  createdById   String?
  createdBy     User?     @relation("RunCreator", fields: [createdById], references: [id])
}

// A saved regrind lot recipe: potency + excipient makeup, reusable across
// runs. Deliberately excludes weight — that's a per-batch physical
// measurement, not a property of the recurring lot type (e.g. "77 starts").
model RegrindLotPreset {
  id                  String   @id @default(cuid())
  name                String   @unique
  potency             Json // PotencyInput shape from lib/calc-engine/types.ts
  disintegrantPercent Float?
  lubricantPercent    Float?
  fillerType          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// A named empty bucket and its tare weight, reusable across bucket fills
// (e.g. "5-gal bucket A"). Deliberately mirrors RegrindLotPreset above: a
// small, unique-by-name lookup table so an operator doesn't re-key the same
// tare every run. Holds no tablet count and no tablet weight — those are
// per-fill figures, not properties of the bucket.
model BucketPreset {
  id          String   @id @default(cuid())
  name        String   @unique
  tareWeightG Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A drafted/reference base formulation from the Formulations library
// builder — a sandbox/reference sheet (in the style of RR8/PB50/PB30-type
// sheets), never tied to a live Fresh Batch or Regrind calculation. Distinct
// from Run (an actual batch calculation) and from Formulation above (the
// internal ingredient template real runs point to via formulationId) —
// deliberately its own model rather than reusing either.
model SavedFormulation {
  id                    String   @id @default(cuid())
  name                  String
  tabletWeightG         Float
  referenceBatchTablets Int
  // Array of { label, targetMgPerTablet, potencyPercent, source } — see
  // SavedFormulationActive in lib/savedFormulations.ts.
  actives               Json
  fillerName            String
  disintegrantName      String?
  disintegrantPercent   Float?
  lubricantName         String?
  lubricantPercent      Float?
  // Glidant (e.g. Silicon Dioxide) — improves powder flow. Additive nullable
  // column, same pattern as disintegrant/lubricant above. Added 2026-08-07.
  glidantName           String?
  glidantPercent        Float?
  // Any further excipients beyond the one disintegrant/lubricant/glidant
  // slots — [{ name, percentOfBlend }] — so sheets like RR77-PB9 (EZTAB
  // alongside PVPP and magnesium stearate) fit whole. Added 2026-09-18,
  // nullable: every earlier formulation simply has none.
  otherExcipients       Json?
  // Set when the formulation came from an uploaded sheet rather than being
  // built in the app; the original is kept in attachment.
  importedFrom          String?
  attachmentId          String?
  attachment            Attachment? @relation(fields: [attachmentId], references: [id])
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Iteration/versioning (added 2026-07-27). lineageId groups every version
  // of one formulation together; null means "this row is its own lineage
  // root" (every consumer falls back to lineageId ?? id — see
  // effectiveLineageId in lib/savedFormulations.ts — the same nullable +
  // in-code-fallback pattern already used for Run's COA fields, rather than
  // a riskier SQLite table-rebuild migration to make it required).
  lineageId    String?
  version      Int      @default(1)
  parentId     String?
  parent       SavedFormulation?  @relation("FormulationLineage", fields: [parentId], references: [id])
  children     SavedFormulation[] @relation("FormulationLineage")
  // 'untested' | 'passed' | 'failed' | 'issue' — drafting-stage outcome
  // tracking, independent of Run's production-lab COA fields above.
  status       String   @default("untested")
  // Review sign-off, deliberately separate from `status` above: that one
  // records how the formulation PERFORMED (untested/passed/failed/issue),
  // this one records whether a reviewer has approved it for use as a master
  // record. A formulation can be approved but untested, or tested and
  // unapproved; collapsing them would lose one of the two.
  reviewStatus String?  // 'pending' | 'approved' | 'rejected'
  legacyReviewerName String? @map("reviewerName")
  reviewerId   String?
  reviewer     User?    @relation("SavedFormulationReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?
  outcomeNotes String?
  // Physical/mechanical context (press, tooling size, fill cam behavior,
  // hopper type, …) that formulation-percentage data alone can't capture.
  // Additive nullable column, same pattern as the outcome fields above.
  equipmentNotes String?

  // Set only on rows auto-promoted from a Run's autosave (see
  // lib/runFormulationSync.ts) — null for every manually-created
  // formulation. @unique (not @relation: Run and SavedFormulation
  // deliberately stay distinct, unrelated models) lets the sync logic
  // upsert by run id so repeated autosaves update this same row instead of
  // creating duplicates, the same way Run's own autosave upserts by run id.
  // SQLite's UNIQUE constraint doesn't apply to NULL, so any number of
  // manually-created rows can coexist with this column left unset.
  sourceRunId String? @unique

  // Soft delete — same retiredAt-style pattern as SpecCriterion below. A
  // hard delete is unsafe here: this row may be a lineage root or a parent
  // with children (the self-relation above), and other versions' parentId
  // would either block the delete or dangle. Null until archived;
  // GET /api/saved-formulations filters this out by default. The single-row
  // GET, the version-chain endpoint, and the troubleshooting chat's
  // cross-formulation search deliberately still return an archived row —
  // archiving hides it from the library list, not from its own lineage
  // history or a direct link.
  deletedAt DateTime?
}

// Historical manufacturing batches, importable via CSV.
model BatchHistory {
  id                      String   @id @default(cuid())
  date                    DateTime
  formulationId           String?
  formulation             Formulation? @relation(fields: [formulationId], references: [id])
  tabletCount             Int
  targetWeightG           Float
  targetActiveMgPerTablet Float
  notes                   String?
  createdAt               DateTime @default(now())
}

// Phase 1 scale-photo verification — a standalone mobile-web feature,
// unrelated to Fresh Batch/Regrind runs, Formulations, or Iterations. A
// photo of a scale display is read by Claude vision (lib/scaleVerification.ts)
// to extract a numeric weight; pass/fail is then computed deterministically
// in code against expectedWeightG +/- tolerance, never asserted by the
// model itself (same "model reads, code computes" split as
// lib/aiVerification.ts's calculate-tool integrity gate).
model ScaleVerification {
  id             String   @id @default(cuid())
  // Real column now even though every row currently gets the same value —
  // see lib/organization.ts's currentOrganizationId() for why this isn't a
  // schema-level @default (keeps the "single value for now" in one
  // app-level place instead of baked into the DB).
  organizationId String
  // Which run and which of that run's already-computed ingredients this
  // verification is for. Required — expectedWeightG below is derived
  // server-side from run.result via lib/runIngredientBreakdown.ts and is
  // never operator-entered, so a verification can't exist without a run to
  // anchor it to. ingredientLabel is a plain string match against that
  // breakdown's labels rather than an ingredient id, since the breakdown is
  // synthesized per-run from calc-engine result JSON and has no stable
  // per-ingredient id of its own.
  runId          String
  run            Run    @relation(fields: [runId], references: [id])
  ingredientLabel String
  expectedWeightG Float
  toleranceType   String // 'absolute' | 'percent'
  toleranceValue  Float
  // The model's raw extraction — immutable after creation, kept so a
  // manager can see exactly what the AI saw even after an operator edit.
  // Null only when the model could not read a number off the display at
  // all — never a stand-in for "photo looked fine but happens to be 0".
  aiReadingWeightG Float?
  // The operator-confirmed value that pass/fail is actually computed
  // against. Defaults to aiReadingWeightG at creation; editable by the
  // operator (e.g. via a correction on the submit page) any time before
  // manager approval, in case the AI misread the display. Independently
  // nullable from aiReadingWeightG so an operator can key in a reading by
  // hand even when the AI failed to read one.
  operatorReadingWeightG Float?
  // 'pass' | 'fail' | null; null exactly when operatorReadingWeightG is null.
  passFail        String?
  // Whether the model was confident in its reading (false for blurry,
  // ambiguous, or non-gram-unit displays) — always populated, not just when
  // unclear, so a human can sanity-check any reading before trusting it.
  confident       Boolean
  modelNotes      String
  // Temporary storage as a data: URL (renders directly in an <img> tag, no
  // separate file-serving route needed) — nulled out, not the row, on
  // manager approval. Everything else on the record is kept permanently.
  photoDataUrl    String?
  // Two-person verification. status/approvedAt already existed and record
  // THAT a second check happened; these record WHO did each half, which is
  // the actual Part 111 requirement — a status flip attributes nothing.
  // Both free-text: there is no auth system (see known gaps).
  legacyWeighedByName  String? @map("weighedByName")
  legacyVerifiedByName String? @map("verifiedByName")
  weighedById    String?
  weighedBy      User?   @relation("WeighedBy", fields: [weighedById], references: [id])
  verifiedById   String?
  verifiedBy     User?   @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  status          String   @default("pending") // 'pending' | 'approved'
  createdAt       DateTime @default(now())
  approvedAt      DateTime?
}

// ---------------------------------------------------------------------------
// Raw material / lot traceability + incoming-component QC specs.
// Added 2026-08-13, entirely additive — no existing model's columns change.
// These describe *physical inventory that arrived on the dock* and the QC
// testing done on it, which is a separate concern from the calc-engine's
// RegrindLot (a per-batch input shape in lib/calc-engine/types.ts, not a
// persisted record) and from the ingredient-name strings that Formulation /
// SavedFormulation carry. Nothing here is wired into the calculators yet.
// ---------------------------------------------------------------------------

// A material as a *kind* ("Magnesium stearate"), not a physical quantity of
// it — the thing lots arrive as and specs are written against.
model RawMaterial {
  id        String   @id @default(cuid())
  name      String   @unique
  // 'active' | 'filler' | 'lubricant' | 'glidant' | 'disintegrant' | 'other'
  // Plain string, not an enum: SQLite has no native enum and the rest of this
  // schema already spells closed sets out this way (Run.passFail, etc.).
  category  String
  createdAt DateTime @default(now())

  lots Lot[]
  // At most one spec per raw material — enforced by @unique on the FK side.
  spec ComponentSpec?
  createdById String?
  createdBy   User?    @relation("RawMaterialCreatedBy", fields: [createdById], references: [id])
}

// A specific physical receipt of a raw material: one lot number, one
// quantity, drawn down over time as runs consume it.
model Lot {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  // Human-entered lot number off the supplier's label / internal tag. Free
  // text on purpose — real lot numbers have no consistent format.
  lotLabel      String
  receivedDate  DateTime
  quantityReceivedG  Float
  // Drawn down as RunLotUsage rows are recorded. Kept as its own stored
  // column rather than derived from usages, so a physical recount or a
  // non-run loss (spillage, sampling for QC) can be reflected directly.
  quantityRemainingG Float
  // 'regroundTablets' | 'rawPowder' | 'purchased'. The first two align
  // exactly with RegrindLotSourceType in lib/calc-engine/types.ts, so a lot
  // fed into a regrind run maps across without translation; 'purchased' is
  // additional here and has no calc-engine meaning — it distinguishes
  // bought-in material from material we produced or reclaimed ourselves.
  sourceType    String
  supplier      String?
  notes         String?
  createdAt     DateTime    @default(now())

  specTests LotSpecTest[]
  runUsages RunLotUsage[]
  adjustments LotAdjustment[]
  // Back-relation for OosInvestigation's FK — virtual, no column here.
  oosInvestigations OosInvestigation[]

  // The same lot number can legitimately recur across different materials,
  // but not twice for the same one — this is what makes lotLabel usable as
  // the operator-facing identifier when scanning/searching.
  @@unique([rawMaterialId, lotLabel])
  // Who received the lot into inventory. Required-by-sign-in with GMP on.
  receivedById  String?
  receivedBy    User?       @relation("LotReceivedBy", fields: [receivedById], references: [id])
}

// The QC spec a raw material's incoming lots are tested against — one per
// raw material.
model ComponentSpec {
  id            String      @id @default(cuid())
  rawMaterialId String      @unique
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  // e.g. "Magnesium stearate NF, in-house spec rev. 3" — the spec document's
  // own title, distinct from the raw material's name.
  name          String
  createdAt     DateTime    @default(now())

  criteria SpecCriterion[]
}

// One testable line on a ComponentSpec, e.g. "Identity", "Purity",
// "Contaminant — heavy metals".
model SpecCriterion {
  id              String        @id @default(cuid())
  componentSpecId String
  componentSpec   ComponentSpec @relation(fields: [componentSpecId], references: [id])
  parameterName   String
  // 'numeric_range' | 'qualitative'
  testType        String
  // Numeric bounds — nullable because they're meaningless on a qualitative
  // criterion, and because a one-sided limit is common (heavy metals has a
  // maxValue and no minValue). A numeric_range criterion with both null
  // can never be evaluated; lib/lotSpecStatus.ts treats that as pending
  // rather than silently passing.
  minValue        Float?
  maxValue        Float?
  targetValue     Float?
  // Human-readable pass condition for qualitative criteria, e.g. "Conforms
  // to reference IR spectrum". Recorded for the tester to judge against —
  // never matched against resultText in code.
  passCriteriaText String?
  createdAt       DateTime      @default(now())
  // Soft delete. "Removing" a criterion from a spec sets this instead of
  // deleting the row, because LotSpecTest's FK to it is RESTRICT — a hard
  // delete would either be blocked or would have to take the historical
  // test results down with it, and those must be retained. A retired
  // criterion is excluded from the active spec and therefore from status
  // (computeLotSpecStatus already ignores tests whose criterion isn't in the
  // criteria list), while every LotSpecTest row that references it stays
  // exactly where it is. Re-adding a retired criterion clears this back to
  // null rather than creating a duplicate.
  retiredAt       DateTime?

  lotTests LotSpecTest[]
}

// A test result: one criterion, evaluated against one lot.
model LotSpecTest {
  id              String        @id @default(cuid())
  lotId           String
  lot             Lot           @relation(fields: [lotId], references: [id])
  specCriterionId String
  specCriterion   SpecCriterion @relation(fields: [specCriterionId], references: [id])
  // Exactly one of these carries the result, per the criterion's testType.
  resultValue     Float?
  resultText      String?
  // For numeric_range criteria this is *computed* in code from resultValue
  // against min/max (evaluateNumericResult in lib/lotSpecStatus.ts) rather
  // than accepted from the client — same "code computes the verdict, not the
  // operator or the model" split as ScaleVerification.passFail. For
  // qualitative criteria there is nothing to compute, so it's the tester's
  // own judgment, set by hand.
  passFail        Boolean
  methodUsed      String?
  testedBy        String?
  testedAt        DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  // Back-relation for OosInvestigation's FK — virtual, no column here.
  // A failing test is only ever set aside by an approved investigation
  // carrying it; see lib/lotSpecStatus.ts.
  oosInvestigations OosInvestigation[]

  // Deliberately NOT unique on (lotId, specCriterionId): retesting a lot
  // after an out-of-spec result is normal. Note that a later passing retest
  // does NOT on its own supersede an earlier failure — see the rollup rules
  // in lib/lotSpecStatus.ts and OosInvestigation below.
  @@index([lotId, specCriterionId])
  // The account that logged the result; with GMP mode on, testedBy is set
  // from it rather than typed.
  testedById      String?
  testedByUser    User?         @relation("SpecTestTestedBy", fields: [testedById], references: [id])
}

// An out-of-specification (OOS) investigation: the formal record of what a
// failing spec result was traced back to, and whether that result may be set
// aside. This is the ONLY thing that can stop a failed LotSpecTest from
// holding its criterion — and its lot — at 'fail' forever. A passing retest
// on its own never clears a failure; without an approved investigation
// concluding the original result was invalid, the retest is just another
// data point next to a failure that still stands.
model OosInvestigation {
  id                  String      @id @default(cuid())
  lotId               String
  lot                 Lot         @relation(fields: [lotId], references: [id])
  // The specific failing result that triggered this investigation. Not
  // unique: an investigation can be reopened, or a second one raised after
  // one closed as confirm_original_result. The rollup asks whether *any*
  // investigation on a failed test is approved-and-invalidating, so an
  // earlier non-invalidating one never blocks a later valid one.
  failedLotSpecTestId String
  failedLotSpecTest   LotSpecTest @relation(fields: [failedLotSpecTestId], references: [id])
  openedBy            String
  openedAt            DateTime    @default(now())
  reasonForInvestigation String
  // Both nullable until the investigation is worked and closed out.
  rootCauseFindings   String?
  // Whether a retest is warranted and scientifically valid. Nullable —
  // undecided until the root cause is understood. Note this is the
  // *justification* to retest, distinct from disposition: justifying a
  // retest does not by itself invalidate the original result.
  retestJustified     Boolean?
  // 'pending' | 'invalidate_original_result' | 'confirm_original_result' |
  // 'reject_lot'. String, not a Prisma enum — enums are unsupported on
  // SQLite, and the rest of this schema spells closed sets out the same way.
  // Only 'invalidate_original_result', AND only once approved, sets the
  // original failure aside; 'confirm_original_result' and 'reject_lot' both
  // leave the lot failed.
  disposition         String      @default("pending")
  // An investigation is closed only once approved — both set together, and
  // the rollup requires both before honoring any disposition.
  approvedBy          String?
  approvedAt          DateTime?
  notes               String?
  createdAt           DateTime    @default(now())

  @@index([lotId])
  @@index([failedLotSpecTestId])
  // The accounts behind openedBy / approvedBy. With GMP mode on these are
  // set from the signed-in session and the typed names are overwritten with
  // the account's name — a typed approver proves nothing, and approval is
  // what clears a failed lot. Null on records from before accounts.
  openedById          String?
  openedByUser        User?       @relation("OosOpenedBy", fields: [openedById], references: [id])
  approvedById        String?
  approvedByUser      User?       @relation("OosApprovedBy", fields: [approvedById], references: [id])
}

// The relational link between a Run and the real physical Lots it consumed.
// Separate from, and not a replacement for, the lot data already embedded in
// Run.inputs / Run.result JSON: that JSON is the calc-engine's own input and
// output (potencies, weights, the numbers the math ran on) and stays the
// source of truth for the calculation. This table answers the traceability
// question that JSON can't — which received-and-QC'd lot the material
// actually came from.
model RunLotUsage {
  id          String   @id @default(cuid())
  runId       String
  run         Run      @relation(fields: [runId], references: [id])
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id])
  amountUsedG Float
  // e.g. "regrind", "fresh_filler", "fresh_lubricant" — how this lot was
  // used in that run. Free string rather than a closed set: the role
  // vocabulary tracks the calculators' ingredient roles, which are still
  // growing.
  roleInRun   String
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([lotId])
}

// ---------------------------------------------------------------------------
// GMP mode (21 CFR Part 111 scaffolding).
//
// A single account-level switch plus its own audit trail. Everything the GMP
// features enforce is gated on this; nothing they DISPLAY is — data stays
// visible with the mode off, only the blocking goes away. That split is
// deliberate: hiding records based on a settings flag would make the app's
// history depend on current configuration, which is the opposite of what an
// audit needs.
// ---------------------------------------------------------------------------

// Singleton — one row, fixed id, same get-or-create shape as the default
// Formulation. A dedicated model rather than a key-value bag because the
// settings are typed and few, and because the lot-status fork below needs a
// real enum-ish column rather than a stringly-typed value.
model GmpSettings {
  id      String  @id @default("singleton")
  enabled Boolean @default(false)
  // What happens when a run consumes a lot whose spec status is fail/pending.
  // 'warn'  — surface it, let the operator proceed (default)
  // 'block' — refuse the run
  // Configurable because CLAUDE.md's Open Flags records that hardcoding
  // either behavior would be wrong for half of users.
  lotStatusEnforcement String @default("warn")
  updatedAt DateTime @updatedAt
}

// Append-only. Every state change writes one row; nothing updates or deletes
// them, and there is no endpoint that can. THIS LOG is the compliance
// artifact — the toggle itself is deliberately not locked, because a lock
// that can be lifted proves nothing while a complete record of who changed
// what and when does.
//
// It also answers "was GMP mode ever on before this record was created",
// which is how grandfathering is decided: the earliest row with
// newState = true is the moment enforcement began. Storing that as its own
// column would be a second source of truth that could disagree with the log.
model GmpModeToggleLog {
  id            String   @id @default(cuid())
  // Free-text name/initials. There is no auth system — see the known-gaps
  // note in the summary; this is NOT verified identity.
  legacyActorName String? @map("actorName")
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  previousState Boolean
  newState      Boolean
  note          String?
  changedAt     DateTime @default(now())

  @@index([changedAt])
}

// A deviation raised against one batch.
//
// Kept as its own model rather than folded into OosInvestigation even though
// the two rhyme: an OOS investigation is scoped to a failing LAB RESULT on a
// received lot, this is scoped to a BATCH whose finished output fell outside
// its target. Sharing one table would mean every query for one concept has to
// remember to exclude the other, and the two have genuinely different
// dispositions — a lot can be rejected, a batch can be reworked.
model RunDeviation {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id])

  // What was observed, and what the investigation concluded. Structured
  // rather than one free-text blob so a reviewer can tell an unexplained
  // deviation from an explained one without reading prose.
  description           String
  investigationFindings String?
  // 'pending' | 'accept_with_justification' | 'reject' | 'rework'
  disposition           String  @default("pending")
  // Required by the API when disposition is accept_with_justification —
  // accepting out-of-spec material without a recorded reason is precisely
  // the thing a deviation record exists to prevent.
  justification         String?

  // Was required free text; now optional, because new records carry a real
  // openedById instead. Existing rows keep their original column and value.
  legacyOpenedBy String?  @map("openedBy")
  openedById     String?
  openedByUser   User?    @relation("DeviationOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime @default(now())
  legacyClosedBy String?  @map("closedBy")
  closedById     String?
  closedByUser   User?    @relation("DeviationClosedBy", fields: [closedById], references: [id])
  closedAt       DateTime?

  @@index([runId])
}


// ---------------------------------------------------------------------------
// Accounts.
//
// Added to close the gap the GMP work shipped with: every identity was a
// free-text string, so nothing stopped one person typing two names to satisfy
// a two-person check. Signatures now resolve to a real account.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // bcrypt hash. Never a plaintext password, and never a hand-rolled digest.
  passwordHash String
  // 'operator' | 'reviewer' | 'admin'. Intentionally a coarse starting point,
  // not a permissions system: it exists so a GMP reviewer sign-off can require
  // someone entitled to give it, which is the one distinction Part 111 needs
  // today.
  role         String   @default("operator")
  createdAt    DateTime @default(now())
  // Soft delete, same reason as Run/SavedFormulation: a user who signed a
  // batch record cannot be erased without orphaning that signature.
  deletedAt    DateTime?
  // Sessions issued before this moment are refused (lib/auth.ts
  // sessionStillValid). Set on password reset and on deactivation, so a
  // reset actually ends whatever session prompted it. Null means never set.
  sessionsValidFrom DateTime?
  // One-time recovery code for a forgotten password (lib/recoveryCode.ts),
  // bcrypt-hashed like the password. Null until the account creates one —
  // accounts made before recovery codes existed have none.
  recoveryCodeHash      String?
  recoveryCodeCreatedAt DateTime?

  reviewedRuns         Run[]               @relation("RunReviewer")
  reviewedFormulations SavedFormulation[]  @relation("SavedFormulationReviewer")
  weighed              ScaleVerification[] @relation("WeighedBy")
  verified             ScaleVerification[] @relation("VerifiedBy")
  openedDeviations     RunDeviation[]      @relation("DeviationOpenedBy")
  closedDeviations     RunDeviation[]      @relation("DeviationClosedBy")
  gmpToggles           GmpModeToggleLog[]
  lotAdjustments       LotAdjustment[]
  labNotes             LabNote[]            @relation("LabNoteAuthor")
  attachments          Attachment[]
  runsCreated          Run[]                @relation("RunCreator")
  oosOpened            OosInvestigation[]   @relation("OosOpenedBy")
  oosApproved          OosInvestigation[]   @relation("OosApprovedBy")
  specTestsLogged      LotSpecTest[]        @relation("SpecTestTestedBy")
  lotsReceived         Lot[]                @relation("LotReceivedBy")
  materialsCreated     RawMaterial[]        @relation("RawMaterialCreatedBy")
  retractedLabNotes    LabNote[]            @relation("LabNoteRetractedBy")
  passwordResets       PasswordResetToken[] @relation("ResetFor")
  issuedPasswordResets PasswordResetToken[] @relation("ResetIssuedBy")
  invitesIssued        Invite[]             @relation("InviteIssuedBy")
  inviteUsed           Invite[]             @relation("InviteUsedBy")

  @@index([email])
}

// A signed correction to a lot's remaining quantity.
//
// Append-only, and deliberately NOT an editable quantity field. An audit wants
// to see that 250g was recorded and then corrected by -50g with a stated
// reason — not a number that silently reads 200g with no trace of the
// correction. Lot.quantityRemainingG stays the running figure so every read
// path is unchanged; this table is the record of WHY it moved outside of a
// run.
//
// Covers the cases CLAUDE.md flagged as having nowhere to go: physical
// recounts, spillage, QC sampling losses, and mis-entered draw-downs.
model LotAdjustment {
  id     String @id @default(cuid())
  lotId  String
  lot    Lot    @relation(fields: [lotId], references: [id])
  // Signed grams. Negative removes stock (spillage, sampling), positive
  // returns it (a reversal, or a recount that found more than recorded).
  deltaG Float
  reason String
  // Nullable for the same reason as the other GMP identity FKs: with GMP mode
  // off an adjustment may be anonymous, and pre-auth rows have no account.
  adjustedById String?
  adjustedBy   User?   @relation(fields: [adjustedById], references: [id])
  adjustedAt   DateTime @default(now())

  @@index([lotId])
}

// Admin-issued one-time password reset link (lib/passwordReset.ts). Only the
// SHA-256 of the token is stored — the token itself is shown to the issuing
// admin once. Rows are kept after use or revocation as a record of who reset
// whose password, and when.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ResetFor", fields: [userId], references: [id])
  issuedById  String
  issuedBy    User      @relation("ResetIssuedBy", fields: [issuedById], references: [id])
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  // Set when a newer link is issued for the same user, or the account is
  // deactivated — an older link must not outlive its replacement.
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Failed sign-in counter, keyed by the normalised email TYPED rather than by
// account, so a lock looks identical for real and unknown emails
// (lib/loginThrottle.ts). Deleted on a successful sign-in or password reset.
model LoginThrottle {
  email         String    @id
  failedCount   Int       @default(0)
  firstFailedAt DateTime?
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

// The lab's shared notebook (lib/labNotes.ts). INTERNAL ONLY — trial and
// error, client remarks, floor problems; never shown to a client.
// No edit path by design: a wrong note is retracted with a reason and stays
// visible, so the notebook records what was known when (same rule as
// LotAdjustment).
model LabNote {
  id        String   @id @default(cuid())
  body      String
  // Product name as used on Run.product. A plain string, not a relation,
  // because products are derived from runs — there is no Product table.
  product   String?
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id])
  // Nullable like the other identity FKs: with GMP mode off a note may be
  // written signed out.
  authorId  String?
  author    User?    @relation("LabNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  retractedAt     DateTime?
  retractedReason String?
  retractedById   String?
  retractedBy     User?    @relation("LabNoteRetractedBy", fields: [retractedById], references: [id])
  // How the text got here: 'typed', 'text_file' (read verbatim from a .txt/
  // .md/.docx) or 'transcribed' (read by AI from an image/PDF, then reviewed).
  source          String   @default("typed")
  attachmentId    String?
  attachment      Attachment? @relation(fields: [attachmentId], references: [id])

  @@index([product])
  @@index([runId])
  @@index([createdAt])
}

// An uploaded original — the photo of a handwritten page, a scanned PDF, a
// Word or text file — kept with the note or formulation it produced, so any
// transcription can always be checked against its source. Stored in the
// database rather than on disk so it can never be swept into git, and is
// backed up with everything else. INTERNAL: served only to the app itself.
model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mediaType    String
  sizeBytes    Int
  sha256       String
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  labNotes     LabNote[]
  formulations SavedFormulation[]

  @@index([sha256])
}

// One-time sign-up link bound to one email (lib/invites.ts). Accounts are
// invite-only once an admin exists. Only the SHA-256 of the token is stored;
// rows are kept after use or cancellation as the record of who let whom in.
model Invite {
  id         String    @id @default(cuid())
  email      String
  // 'operator' | 'reviewer' — admin is never granted by a link.
  role       String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  issuedById String
  issuedBy   User      @relation("InviteIssuedBy", fields: [issuedById], references: [id])
  usedById   String?
  usedBy     User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([email])
}
