generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ingredient template — matches the IngredientLine[] shape in lib/calc-engine/types.ts
model Formulation {
  id        String   @id @default(cuid())
  name      String   @unique
  ingredients Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs         Run[]
  batchHistory BatchHistory[]
}

// A saved calculation: the inputs that produced it, the computed output, and
// which formulation template was in effect.
model Run {
  id            String   @id @default(cuid())
  label         String
  mode          String // 'fresh' | 'regrind'
  formulationId String
  formulation   Formulation @relation(fields: [formulationId], references: [id])
  inputs        Json
  result        Json
  // Audit trail for a Tier 2 AI-verification discrepancy the operator
  // reviewed and acknowledged before saving: { acknowledgedAt, field,
  // reportedValue, computedValue, delta, unit }. Null when the run had no
  // discrepancy needing review.
  verificationAcknowledgment Json?
  createdAt     DateTime @default(now())

  // COA (Certificate of Analysis) results, entered on the Run History page
  // after the batch is physically made and lab-tested. All nullable/additive
  // — absent on every run until an operator records them.
  actualMgPerTablet  Float?
  actualTabletWeight Float?
  passFail           String? // 'pass' | 'fail'
  notes              String?
}

// A saved regrind lot recipe: potency + excipient makeup, reusable across
// runs. Deliberately excludes weight — that's a per-batch physical
// measurement, not a property of the recurring lot type (e.g. "77 starts").
model RegrindLotPreset {
  id                  String   @id @default(cuid())
  name                String   @unique
  potency             Json // PotencyInput shape from lib/calc-engine/types.ts
  disintegrantPercent Float?
  lubricantPercent    Float?
  fillerType          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// A drafted/reference base formulation from the Formulations library
// builder — a sandbox/reference sheet (in the style of RR8/PB50/PB30-type
// sheets), never tied to a live Fresh Batch or Regrind calculation. Distinct
// from Run (an actual batch calculation) and from Formulation above (the
// internal ingredient template real runs point to via formulationId) —
// deliberately its own model rather than reusing either.
model SavedFormulation {
  id                    String   @id @default(cuid())
  name                  String
  tabletWeightG         Float
  referenceBatchTablets Int
  // Array of { label, targetMgPerTablet, potencyPercent, source } — see
  // SavedFormulationActive in lib/savedFormulations.ts.
  actives               Json
  fillerName            String
  disintegrantName      String?
  disintegrantPercent   Float?
  lubricantName         String?
  lubricantPercent      Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Iteration/versioning (added 2026-07-27). lineageId groups every version
  // of one formulation together; null means "this row is its own lineage
  // root" (every consumer falls back to lineageId ?? id — see
  // effectiveLineageId in lib/savedFormulations.ts — the same nullable +
  // in-code-fallback pattern already used for Run's COA fields, rather than
  // a riskier SQLite table-rebuild migration to make it required).
  lineageId    String?
  version      Int      @default(1)
  parentId     String?
  parent       SavedFormulation?  @relation("FormulationLineage", fields: [parentId], references: [id])
  children     SavedFormulation[] @relation("FormulationLineage")
  // 'untested' | 'passed' | 'failed' | 'issue' — drafting-stage outcome
  // tracking, independent of Run's production-lab COA fields above.
  status       String   @default("untested")
  outcomeNotes String?
}

// Historical manufacturing batches, importable via CSV.
model BatchHistory {
  id                      String   @id @default(cuid())
  date                    DateTime
  formulationId           String?
  formulation             Formulation? @relation(fields: [formulationId], references: [id])
  tabletCount             Int
  targetWeightG           Float
  targetActiveMgPerTablet Float
  notes                   String?
  createdAt               DateTime @default(now())
}
